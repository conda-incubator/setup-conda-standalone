{
  "name": "setup-conda-standalone",
  "version": "0.1.0",
  "private": true,
  "description": "Action to set up conda-standalone",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "all": "run-s build lint-fix test",
    "build": "run-s type-check compile",
    "compile": "tsdown",
    "dev": "tsdown --watch",
    "eslint": "eslint",
    "eslint-fix": "eslint --fix",
    "lint": "run-s eslint prettier",
    "lint-fix": "run-s eslint-fix prettier-fix",
    "prettier": "prettier --check '**/*.{cjs,js,json,mjs,mts,ts}'",
    "prettier-fix": "prettier --write --check '**/*.{cjs,js,json,mjs,mts,ts}'",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/tool-cache": "4.0.0",
    "dev": "0.1.5",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@containerbase/eslint-plugin": "^2.1.1",
    "@eslint/js": "10.0.1",
    "@microsoft/tsdoc": "0.16.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-gha": "2.0.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-import-zod": "^1.2.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.12.0",
    "js-yaml": "^5.4.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
